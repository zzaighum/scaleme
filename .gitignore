# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
logs/

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db

# local tool state (keep the shared launch config, ignore per-user settings)
.claude/*
!.claude/launch.json

# scratch exports from design review
.figma-review/

# supabase CLI local state
supabase/.branches
supabase/.temp

# QA harness (UI/UX pass) — not part of the shipped site
/test-results/
/playwright-report/
/qa-artifacts/
