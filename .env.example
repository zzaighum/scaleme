# Copy this file to .env.local and fill in real values before switching to live mode.
# Never commit .env.local or any file containing real secrets.

# --- Public values (safe to expose in the browser; also used at build time) ---

# "preview" (default) runs the illustrative demo flow: no real enquiries are
# stored, no real notifications are sent, and the site is excluded from indexing.
# Set to "live" only once SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY and, if you
# want notifications, NOTIFICATION_WEBHOOK_URL are configured and tested.
NEXT_PUBLIC_SITE_MODE=preview

# The final public domain, used for canonical URLs, the sitemap, and OG images.
# Set this in the host BEFORE the first build. Like every NEXT_PUBLIC_* value it
# is inlined at build time, so changing it later needs a redeploy — and until it
# is set, every canonical, og:image and sitemap <loc> ships as localhost.
# The live site is https://yourleadspartner.com (confirmed 26 Oct 2026).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Overrides the provisional "YourLeadspartner" brand once a name is chosen.
NEXT_PUBLIC_BRAND_NAME=

# The real registered/trading business name, shown in the footer copyright line.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=

# A monitored inbox shown in the footer and used as a fallback contact channel
# wherever scheduling isn't configured.
NEXT_PUBLIC_CONTACT_EMAIL=

# Booking mode is "external" by default: after a successful enquiry, visitors
# are sent to your hosted scheduler link. "connected" (webhook-verified) mode
# is documented but not implemented in this build — see LAUNCH_CHECKLIST.md.
NEXT_PUBLIC_BOOKING_MODE=external

# A real hosted scheduler URL (e.g. Cal.com, Calendly). Leave blank to hide
# the scheduling area entirely.
NEXT_PUBLIC_BOOKING_URL=

# Where the enquiry form posts. STATIC BRANCH ONLY. Blank leaves the form an
# illustrative demo that captures nothing and says so on screen.
# For Salesforce Web-to-Lead:
#   https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8
NEXT_PUBLIC_FORM_ENDPOINT=

# The Salesforce org that owns the leads (Setup > Company Information >
# Salesforce.com Organization ID). Setting this alongside the endpoint above
# switches the form to a native POST, because Web-to-Lead sends no CORS headers
# and a background request to it is blocked by the browser.
NEXT_PUBLIC_SALESFORCE_ORG_ID=

# Google reCAPTCHA v2 site key. REQUIRED if the Salesforce org has "Require
# reCAPTCHA Verification" switched on under Setup > Web-to-Lead; without a
# token Salesforce discards the submission. Leave blank only if that setting
# is off. This is the PUBLIC half of the pair — the secret key is entered in
# Salesforce and must never appear in a NEXT_PUBLIC_ variable, which is
# compiled into the browser bundle.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# The nickname of the key pair as saved in Salesforce (Setup > Web-to-Lead >
# reCAPTCHA API Key Pair). Salesforce matches the submission to the key pair by
# this name, so it must match exactly.
NEXT_PUBLIC_RECAPTCHA_KEY_NAME=

# Set to "false" only if "Enable server fallback" is unticked in Web-to-Lead
# Settings. Defaults to true, matching Salesforce's own default.
NEXT_PUBLIC_RECAPTCHA_FALLBACK=

# Optional. The 18-character id of a custom field on Lead holding the chosen
# main IT service. Lead has no stock field for it (Industry is a picklist of
# Salesforce's own values), so without this the service is not sent.
NEXT_PUBLIC_SALESFORCE_SERVICE_FIELD_ID=

# Optional, for one-off testing. Salesforce emails the raw submission to this
# address INSTEAD of creating a Lead. Clear it once the mapping is confirmed.
NEXT_PUBLIC_WEB_TO_LEAD_DEBUG_EMAIL=

# --- Private values (server-only; never prefix these with NEXT_PUBLIC_) ---

# Supabase project URL and service role key. The service role key bypasses
# Row Level Security, so it must only ever be read on the server — see
# src/lib/supabaseAdmin.ts. Required for live mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HTTPS endpoint that receives a JSON POST for each new enquiry (e.g. a
# Slack/Zapier/Make webhook, or your own email-sending endpoint). If unset,
# enquiries are still captured, but no owner notification is sent — the
# route handler records the miss on the lead's row for manual follow-up.
NOTIFICATION_WEBHOOK_URL=

# Reserved for a future "connected" booking mode (verifying an authenticated
# provider webhook). Not read by any code in this build yet.
BOOKING_WEBHOOK_SECRET=

# Signs the /thank-you receipt token (HMAC-SHA256). Generate with:
#   openssl rand -hex 32
# Required in any environment that must keep validating receipts across
# restarts (i.e. live mode). Without it, a random secret is generated per
# process, which is fine for local preview only.
RECEIPT_SIGNING_SECRET=
